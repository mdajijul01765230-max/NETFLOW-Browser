# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional HTTPS API base URL for native/remote builds (leave empty for same-origin).
# VITE_API_BASE_URL=

# VITE_API_ACCESS_TOKEN: Optional client access token sent as X-Netflow-Access-Token header when set.
# SECURITY NOTE: Any token embedded in a client bundle or mobile APK (VITE_API_ACCESS_TOKEN) can be
# extracted by inspecting the client build. It serves ONLY as a weak abuse/traffic gate, NOT a true secret.
# VITE_API_ACCESS_TOKEN=

# NETFLOW_API_ACCESS_TOKEN: Optional server-side access token gate for /api/browse and /api/ai/*.
# When set, requests must provide a matching X-Netflow-Access-Token header. Leave empty to disable.
# NETFLOW_API_ACCESS_TOKEN=

# ALLOWED_ORIGINS: Optional comma-separated list of exact https:// origins permitted for cross-origin API requests.
# Wildcards (*) and non-HTTPS (http://) origins in ALLOWED_ORIGINS are ignored.
# ALLOWED_ORIGINS=

# TRUST_PROXY: Optional reverse-proxy hop trust setting (default: off / false / 0).
# When off (default), rate limiting uses the direct socket address (req.socket.remoteAddress)
# and ignores X-Forwarded-For so clients cannot spoof their IP.
# When deployed behind a reverse proxy / load balancer (e.g. generic container hosting with 1 proxy hop),
# set TRUST_PROXY=1 so Express trusts 1 proxy hop and each user gets their own rate-limit bucket.
# TRUST_PROXY=off

# PORT: HTTP listen port for the backend server (default: 3000).
# PORT=3000

# Rate limit & response cap configuration (optional overrides):
# RATE_LIMIT_WINDOW_MS=60000
# BROWSE_RATE_LIMIT_PER_MIN=60
# AI_RATE_LIMIT_PER_MIN=20
# COOKIES_CLEAR_RATE_LIMIT_PER_MIN=30
# MAX_RESPONSE_BYTES=5242880

